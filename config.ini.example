; config.ini - Faqture Configuration
; Copy this file to config.ini and edit with your values.

[BASE]
DB_NAME = your_database_name
DB_USER = postgres
DB_PASS = your_password
DB_HOST = 127.0.0.1
DB_PORT = 5432

[BACKUP]
BU_NAME = FaqtureBackup
BU_STATE = False
BU_DRIVE = False
BU_TIME = 00:00:00
BU_TIME2 = 23:59:00

[MAIN]
M_DOC = True
M_ANUL = False
M_NCREDI = False
M_NVENTAS = False
M_GUIA = False

[MODELS]
DATE_HEADER = 2025-01-01

[APP]
DEBUG = False

[API]
SSL_VERIFY = False

[BACKEND]
BACKEND_URL = https://your-faqture-back-url.com
POLL_INTERVAL = 43200

[CLIENT]
CLIENT_NAME = Nombre descriptivo del cliente
